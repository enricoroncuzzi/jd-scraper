# OpenRouter API key (https://openrouter.ai/settings/keys). Used by scoring
# (src/scorer.py), remote verification (src/remote_verifier.py, primary), and
# tailoring (src/tailor/generate.py). Free-tier models only; see each module's
# model constants.
LLM_API_KEY=
# Groq API key. Verification fallback only (openai/gpt-oss-20b).
GROQ_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
OUTPUT_PATH=output
DEDUP_LOG_PATH=
DATABASE_URL=
# Server job store: the PostgreSQL database on the VPS that the collector, processor and
# delivery services share (src/jobstore/db.py). Peer authentication over the unix socket.
JOBSTORE_URL=postgresql:///jds

# CV and cover-letter source content tailor.py reads - not part of this repo (personal
# content). Required on any machine other than the one the fallback paths in tailor.py's
# _DEFAULT_MASTER/_DEFAULT_CSS/_DEFAULT_CL_MASTER were hardcoded for. See AGENTS.md.
CV_MASTER_PATH=
CV_CSS_PATH=
CL_MASTER_PATH=
JD_OUTPUT_ROOT=
