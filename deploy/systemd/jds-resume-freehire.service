[Unit]
Description=jd-scraper freehire collector (resume an unfinished walk)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=enrico
Group=enrico
WorkingDirectory=/home/enrico/jd-scraper
EnvironmentFile=/home/enrico/jd-scraper/.env
ExecStart=/home/enrico/jd-scraper/.venv/bin/python -u -m src.sources.service freehire --resume
TimeoutStartSec=1800
MemoryHigh=150M
MemoryMax=192M
Nice=5
NoNewPrivileges=true
PrivateTmp=true
