[Unit]
Description=jd-scraper deliver (daily delivery, alerts, packaging, archive)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=enrico
Group=enrico
WorkingDirectory=/home/enrico/jd-scraper
EnvironmentFile=/home/enrico/jd-scraper/.env
ExecStart=/home/enrico/jd-scraper/.venv/bin/python -u -m src.delivery.service
Restart=always
RestartSec=10
TimeoutStopSec=300
MemoryHigh=650M
MemoryMax=768M
Nice=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
